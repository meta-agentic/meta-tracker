# Vectis web client — copy to `.env.local` (git-ignored) and fill in.
# No value is committed: the repository never carries a host or a credential.

# Base URL of the Vectis API. Absolute for a split deployment, or left unset to
# use the same-origin default `/api/v1`.
VITE_VECTIS_API_BASE_URL=

# Short workspace key the client loads, e.g. VEC. Required: 2-10 upper-case
# alphanumeric characters starting with a letter, matching the server's format.
VITE_VECTIS_WORKSPACE_KEY=

# Per-request timeout in milliseconds. Optional; defaults to 10000.
VITE_VECTIS_API_TIMEOUT_MS=

# Development only: serve a canned workspace instead of calling the API, to look
# at the UI with no server running. Ignored by production builds. Scenarios are
# picked with ?fixture=ready|slow|error|empty.
VITE_VECTIS_FIXTURES=
