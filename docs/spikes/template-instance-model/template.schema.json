{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workflow template document, template delta or workspace delta",
  "description": "Shape only. A root template is complete; a derived template carries extends plus a delta; a workspace delta carries sections only. In a delta, null removes an element (tombstone) or unsets a field. Completeness, references, categories and outcomes are checked by resolution, which reports the same dotted paths.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "template": {"$ref": "#/$defs/key"},
    "version": {"type": "integer", "minimum": 1},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "extends": {
      "type": "object",
      "additionalProperties": false,
      "required": ["template", "version"],
      "properties": {
        "template": {"$ref": "#/$defs/key"},
        "version": {"type": "integer", "minimum": 1}
      }
    },
    "locks": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(stateOrder|(settings|cadence)(\\.[a-zA-Z]+)?|(states|itemTypes|fields)(\\.[a-z][a-zA-Z0-9-]{0,31}(\\.[a-zA-Z]+)?)?)$"
      }
    },
    "states": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/key"},
      "additionalProperties": {
        "oneOf": [
          {"$ref": "#/$defs/states"},
          {"type": "null"}
        ]
      }
    },
    "stateOrder": {"$ref": "#/$defs/keys"},
    "itemTypes": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/key"},
      "additionalProperties": {
        "oneOf": [
          {"$ref": "#/$defs/itemTypes"},
          {"type": "null"}
        ]
      }
    },
    "fields": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/key"},
      "additionalProperties": {
        "oneOf": [
          {"$ref": "#/$defs/fields"},
          {"type": "null"}
        ]
      }
    },
    "settings": {"$ref": "#/$defs/settings"},
    "cadence": {"$ref": "#/$defs/cadence"},
    "deliveryGates": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Resolved documents only, never authored: the gate locks frozen where settings.gatedDelivery became binding; only these gates count for it below that level."
    }
  },
  "$defs": {
    "key": {"type": "string", "pattern": "^[a-z][a-zA-Z0-9-]{0,31}$"},
    "keys": {
      "type": "array",
      "items": {"$ref": "#/$defs/key"}
    },
    "states": {
      "description": "One state (a board column). An END_STATE declares its outcome; no other state has one.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"type": ["string", "null"], "minLength": 1},
        "description": {"type": ["string", "null"]},
        "category": {"enum": ["START_STATE", "IN_PROGRESS", "END_STATE", null]},
        "outcome": {"enum": ["DELIVERED", "DISCONTINUED", null]},
        "onBoard": {"type": ["boolean", "null"]},
        "after": {
          "oneOf": [
            {"$ref": "#/$defs/key"},
            {"type": "null"}
          ]
        },
        "before": {
          "oneOf": [
            {"$ref": "#/$defs/key"},
            {"type": "null"}
          ]
        },
        "wipLimit": {"type": ["integer", "null"], "minimum": 1},
        "enterFrom": {
          "oneOf": [
            {"$ref": "#/$defs/keys"},
            {"type": "null"}
          ]
        },
        "gate": {
          "oneOf": [
            {"$ref": "#/$defs/gate"},
            {"type": "null"}
          ]
        }
      }
    },
    "itemTypes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"type": ["string", "null"], "minLength": 1},
        "description": {"type": ["string", "null"]},
        "parents": {
          "oneOf": [
            {"$ref": "#/$defs/keys"},
            {"type": "null"}
          ]
        }
      }
    },
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"type": ["string", "null"], "minLength": 1},
        "description": {"type": ["string", "null"]},
        "type": {"enum": ["number", "text", "date", null]},
        "scale": {"enum": ["fibonacci", "linear", null]}
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultItemType": {
          "oneOf": [
            {"$ref": "#/$defs/key"},
            {"type": "null"}
          ]
        },
        "gatedDelivery": {
          "type": ["boolean", "null"],
          "description": "Every way from a start state to a DELIVERED end state passes a gate."
        }
      }
    },
    "cadence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {"enum": ["sprint", "flow", "phase", null]},
        "sprintDays": {"type": ["integer", "null"], "minimum": 1, "maximum": 56}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approvals"],
      "properties": {
        "approvals": {"type": "integer", "minimum": 1}
      }
    }
  }
}
