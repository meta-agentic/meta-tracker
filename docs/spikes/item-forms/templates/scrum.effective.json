{
  "template": "scrum",
  "version": 2,
  "name": "Scrum",
  "states": {
    "backlog": {"name": "Backlog", "category": "START_STATE"},
    "todo": {"name": "To Do", "category": "START_STATE"},
    "in-progress": {"name": "In Progress", "category": "IN_PROGRESS", "requires": ["storyPoints"]},
    "in-review": {"name": "In Review", "category": "IN_PROGRESS"},
    "done": {"name": "Done", "category": "END_STATE", "outcome": "DELIVERED"},
    "no-go": {"name": "No Go", "category": "END_STATE", "outcome": "DISCONTINUED", "onBoard": false}
  },
  "stateOrder": ["backlog", "todo", "in-progress", "in-review", "done", "no-go"],
  "itemTypes": {
    "epic": {"name": "Epic", "fields": ["description", "priority"]},
    "story": {"name": "Story", "parents": ["epic"], "fields": ["description", "storyPoints", "priority"]},
    "bug": {"name": "Bug", "parents": ["epic"], "fields": ["description", "storyPoints", "priority"], "required": ["description"]},
    "task": {"name": "Task", "parents": ["story", "bug"], "fields": ["description"]}
  },
  "fields": {
    "description": {"name": "Description", "type": "markdown"},
    "storyPoints": {"name": "Story points", "type": "number", "scale": "fibonacci"},
    "priority": {
      "name": "Priority",
      "type": "choice",
      "options": [{"key": "high", "name": "High"}, {"key": "medium", "name": "Medium"}, {"key": "low", "name": "Low"}],
      "default": "medium"
    }
  },
  "settings": {"defaultItemType": "story"},
  "cadence": {"mode": "sprint", "sprintDays": 14}
}
