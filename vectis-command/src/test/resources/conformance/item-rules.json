{
  "about": "One set of item-field rules, two evaluators: the command layer (FieldRulesConformanceTest) and the web client (src/forms/rules.test.ts) must give exactly these violations, as [field, code] pairs in this order. A case's template is a shipped built-in, read from its golden resolution in vectis-domain's test resources; an optional delta is merged over it as a workspace delta would be.",
  "cases": [
    {
      "name": "C1 a story with points on the scale and a priority",
      "template": "scrum",
      "write": {
        "op": "create",
        "state": "todo",
        "title": "Sign in",
        "fields": {
          "type": "story",
          "storyPoints": 5,
          "priority": "high"
        }
      },
      "expect": []
    },
    {
      "name": "C2 points off the scale",
      "template": "scrum",
      "write": {
        "op": "create",
        "state": "todo",
        "title": "Sign in",
        "fields": {
          "type": "story",
          "storyPoints": 4
        }
      },
      "expect": [
        [
          "fields.storyPoints",
          "scale"
        ]
      ]
    },
    {
      "name": "C3 a bug needs a description, always",
      "template": "scrum",
      "write": {
        "op": "create",
        "state": "backlog",
        "title": "Crash",
        "fields": {
          "type": "bug"
        }
      },
      "expect": [
        [
          "fields.description",
          "required"
        ]
      ]
    },
    {
      "name": "C4 a task has no story points",
      "template": "scrum",
      "write": {
        "op": "create",
        "state": "todo",
        "title": "Wire it",
        "fields": {
          "type": "task",
          "storyPoints": 3
        }
      },
      "expect": [
        [
          "fields.storyPoints",
          "notOnType"
        ]
      ]
    },
    {
      "name": "C5 with no type the workspace's default type is used",
      "template": "scrum",
      "write": {
        "op": "create",
        "state": "todo",
        "title": "Sign in"
      },
      "expect": []
    },
    {
      "name": "C6 a type the workspace does not have",
      "template": "scrum",
      "write": {
        "op": "create",
        "state": "todo",
        "title": "Sign in",
        "fields": {
          "type": "feature"
        }
      },
      "expect": [
        [
          "fields.type",
          "unknownType"
        ]
      ]
    },
    {
      "name": "C7 a priority that is not an option",
      "template": "scrum",
      "write": {
        "op": "create",
        "state": "todo",
        "title": "Sign in",
        "fields": {
          "type": "story",
          "priority": "urgent"
        }
      },
      "expect": [
        [
          "fields.priority",
          "option"
        ]
      ]
    },
    {
      "name": "C8 points that are not a number",
      "template": "scrum",
      "write": {
        "op": "create",
        "state": "todo",
        "title": "Sign in",
        "fields": {
          "type": "story",
          "storyPoints": "5"
        }
      },
      "expect": [
        [
          "fields.storyPoints",
          "type"
        ]
      ]
    },
    {
      "name": "C9 a blank title",
      "template": "scrum",
      "write": {
        "op": "create",
        "state": "todo",
        "title": "  ",
        "fields": {
          "type": "story"
        }
      },
      "expect": [
        [
          "title",
          "required"
        ]
      ]
    },
    {
      "name": "C10 a title and a field broken together are both named",
      "template": "scrum",
      "write": {
        "op": "create",
        "state": "todo",
        "title": "",
        "fields": {
          "type": "bug",
          "storyPoints": 4
        }
      },
      "expect": [
        [
          "title",
          "required"
        ],
        [
          "fields.storyPoints",
          "scale"
        ],
        [
          "fields.description",
          "required"
        ]
      ]
    },
    {
      "name": "C11 undeclared fields are the open long tail and pass",
      "template": "scrum",
      "write": {
        "op": "create",
        "state": "todo",
        "title": "Sign in",
        "fields": {
          "type": "story",
          "labels": [
            "web"
          ]
        }
      },
      "expect": []
    },
    {
      "name": "C12 an edit of the points to a value on the scale",
      "template": "scrum",
      "write": {
        "op": "edit",
        "fields": {
          "storyPoints": 8
        },
        "item": {
          "state": "todo",
          "fields": {
            "type": "story",
            "storyPoints": 5
          }
        }
      },
      "expect": []
    },
    {
      "name": "C13 an edit of the points off the scale",
      "template": "scrum",
      "write": {
        "op": "edit",
        "fields": {
          "storyPoints": 7
        },
        "item": {
          "state": "todo",
          "fields": {
            "type": "story",
            "storyPoints": 5
          }
        }
      },
      "expect": [
        [
          "fields.storyPoints",
          "scale"
        ]
      ]
    },
    {
      "name": "C14 the type is set at creation only",
      "template": "scrum",
      "write": {
        "op": "edit",
        "fields": {
          "type": "bug"
        },
        "item": {
          "state": "todo",
          "fields": {
            "type": "story"
          }
        }
      },
      "expect": [
        [
          "fields.type",
          "type"
        ]
      ]
    },
    {
      "name": "C15 a bug from before descriptions were required can still be renamed",
      "template": "scrum",
      "write": {
        "op": "edit",
        "title": "Crash on start",
        "item": {
          "state": "todo",
          "fields": {
            "type": "bug"
          }
        }
      },
      "expect": []
    },
    {
      "name": "C15b and its points can be changed without one",
      "template": "scrum",
      "write": {
        "op": "edit",
        "fields": {
          "storyPoints": 3
        },
        "item": {
          "state": "todo",
          "fields": {
            "type": "bug"
          }
        }
      },
      "expect": []
    },
    {
      "name": "C16 but its description, once touched, cannot be emptied",
      "template": "scrum",
      "write": {
        "op": "edit",
        "fields": {
          "description": ""
        },
        "item": {
          "state": "todo",
          "fields": {
            "type": "bug",
            "description": "Boom"
          }
        }
      },
      "expect": [
        [
          "fields.description",
