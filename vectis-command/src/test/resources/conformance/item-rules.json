        ]
      ]
    },
    {
      "name": "C17 nor removed",
      "template": "scrum",
      "write": {
        "op": "edit",
        "fields": {
          "description": null
        },
        "item": {
          "state": "todo",
          "fields": {
            "type": "bug",
            "description": "Boom"
          }
        }
      },
      "expect": [
        [
          "fields.description",
          "required"
        ]
      ]
    },
    {
      "name": "C18 a workspace that needs points to start: creating a story straight into In Progress",
      "template": "scrum",
      "delta": {
        "states": {
          "in-progress": {
            "requires": [
              "storyPoints"
            ]
          }
        }
      },
      "write": {
        "op": "create",
        "state": "in-progress",
        "title": "Sign in",
        "fields": {
          "type": "story"
        }
      },
      "expect": [
        [
          "fields.storyPoints",
          "requiredToEnter"
        ]
      ]
    },
    {
      "name": "C19 a task enters In Progress freely: it has no points field",
      "template": "scrum",
      "delta": {
        "states": {
          "in-progress": {
            "requires": [
              "storyPoints"
            ]
          }
        }
      },
      "write": {
        "op": "create",
        "state": "in-progress",
        "title": "Wire it",
        "fields": {
          "type": "task"
        }
      },
      "expect": []
    },
    {
      "name": "C20 moving an unestimated story into In Progress",
