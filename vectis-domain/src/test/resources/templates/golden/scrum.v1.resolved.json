{
  "template": "scrum",
  "version": 1,
  "name": "Scrum",
  "extends": {"template": "base", "version": 1},
  "states": {
    "backlog": {"name": "Backlog", "category": "START_STATE", "before": "todo"},
    "todo": {"name": "To Do", "category": "START_STATE"},
    "in-progress": {"name": "In Progress", "category": "IN_PROGRESS"},
    "in-review": {"name": "In Review", "category": "IN_PROGRESS", "after": "in-progress"},
    "done": {"name": "Done", "category": "END_STATE", "outcome": "DELIVERED"},
    "no-go": {
      "name": "No Go",
      "category": "END_STATE",
      "outcome": "DISCONTINUED",
      "onBoard": false
    }
  },
  "stateOrder": ["backlog", "todo", "in-progress", "in-review", "done", "no-go"],
  "itemTypes": {
    "task": {"name": "Task", "parents": ["story", "bug"]},
    "story": {"name": "Story", "parents": ["epic"]},
    "bug": {"name": "Bug", "parents": ["epic"]},
    "epic": {"name": "Epic"}
  },
  "fields": {
    "storyPoints": {"name": "Story points", "type": "number", "scale": "fibonacci"}
  },
  "settings": {"defaultItemType": "story"},
  "cadence": {"mode": "sprint", "sprintDays": 14}
}
