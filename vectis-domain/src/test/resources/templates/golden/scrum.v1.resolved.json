{
  "template": "scrum",
  "version": 1,
  "name": "Scrum",
  "extends": {"template": "base", "version": 1},
  "states": {
    "backlog": {"name": "Backlog", "category": "START_STATE", "before": "todo"},
    "todo": {"name": "To Do", "category": "START_STATE"},
    "in-progress": {"name": "In Progress", "category": "IN_PROGRESS"},
    "in-review": {"name": "In Review", "category": "IN_PROGRESS", "after": "in-progress"},
    "done": {"name": "Done", "category": "END_STATE", "outcome": "DELIVERED"},
    "no-go": {
      "name": "No Go",
      "category": "END_STATE",
      "outcome": "DISCONTINUED",
      "onBoard": false
    }
  },
  "stateOrder": ["backlog", "todo", "in-progress", "in-review", "done", "no-go"],
  "itemTypes": {
    "task": {
      "name": "Task",
      "parents": ["story", "bug"],
      "icon": "task",
      "fields": ["description"]
    },
    "story": {
      "name": "Story",
      "parents": ["epic"],
      "icon": "story",
      "fields": ["description", "storyPoints", "priority"]
    },
    "bug": {
      "name": "Bug",
      "parents": ["epic"],
      "icon": "bug",
      "fields": ["description", "storyPoints", "priority"],
      "required": ["description"]
    },
    "epic": {"name": "Epic", "icon": "epic", "fields": ["description", "priority"]}
  },
  "fields": {
    "storyPoints": {"name": "Story points", "type": "number", "scale": "fibonacci"},
    "description": {"name": "Description", "type": "markdown"},
    "priority": {
      "name": "Priority",
      "type": "choice",
      "options": [
        {"key": "high", "name": "High", "icon": "high"},
        {"key": "medium", "name": "Medium", "icon": "medium"},
        {"key": "low", "name": "Low", "icon": "low"}
      ],
      "default": "medium"
    }
  },
  "settings": {"defaultItemType": "story"},
  "cadence": {"mode": "sprint", "sprintDays": 14}
}
