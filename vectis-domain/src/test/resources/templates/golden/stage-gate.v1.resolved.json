{
  "template": "stage-gate",
  "version": 1,
  "name": "Stage-Gate",
  "description": "Stages separated by gates; a gate decides go, recycle or kill with approvals.",
  "extends": {"template": "base", "version": 1},
  "states": {
    "idea": {"name": "Idea", "category": "START_STATE", "enterFrom": []},
    "scoping": {
      "name": "Scoping",
      "category": "IN_PROGRESS",
      "enterFrom": ["idea", "gate-1"]
    },
    "gate-1": {
      "name": "Gate 1: go to development",
      "category": "IN_PROGRESS",
      "enterFrom": ["scoping"],
      "gate": {"approvals": 2},
      "requires": ["businessCase"]
    },
    "development": {
      "name": "Development",
      "category": "IN_PROGRESS",
      "enterFrom": ["gate-1", "gate-2"]
    },
    "gate-2": {
      "name": "Gate 2: go to launch",
      "category": "IN_PROGRESS",
      "enterFrom": ["development"],
      "gate": {"approvals": 2}
    },
    "done": {
      "name": "Launched",
      "category": "END_STATE",
      "outcome": "DELIVERED",
      "enterFrom": ["gate-2"]
    },
    "no-go": {
      "name": "Killed",
      "category": "END_STATE",
      "outcome": "DISCONTINUED",
      "onBoard": false,
      "enterFrom": ["idea", "gate-1", "gate-2"]
    }
  },
  "stateOrder": ["idea", "scoping", "gate-1", "development", "gate-2", "done", "no-go"],
  "itemTypes": {
    "task": {
      "name": "Task",
      "parents": ["deliverable"],
      "icon": "task",
      "fields": ["description"]
    },
    "project": {
      "name": "Project",
      "icon": "project",
      "fields": ["description", "businessCase", "risk", "targetLaunch"]
    },
    "deliverable": {
      "name": "Deliverable",
      "parents": ["project"],
      "icon": "deliverable",
      "fields": ["description", "targetLaunch"]
    },
    "milestone": {
      "name": "Milestone",
      "parents": ["project"],
      "icon": "milestone",
      "fields": ["targetLaunch"],
      "required": ["targetLaunch"]
    }
  },
  "fields": {
    "description": {"name": "Description", "type": "markdown"},
    "businessCase": {"name": "Business case", "type": "markdown"},
    "risk": {
      "name": "Risk",
      "type": "choice",
      "options": [
        {"key": "low", "name": "Low", "icon": "low"},
        {"key": "medium", "name": "Medium", "icon": "medium"},
        {"key": "high", "name": "High", "icon": "high"}
      ]
    },
    "targetLaunch": {"name": "Target launch", "type": "date"}
  },
  "settings": {"defaultItemType": "project", "gatedDelivery": true},
  "cadence": {"mode": "phase"},
  "locks": ["settings.gatedDelivery", "states.development.enterFrom", "states.done.enterFrom", "states.gate-1.enterFrom", "states.gate-1.gate", "states.gate-2.enterFrom", "states.gate-2.gate"],
  "deliveryGates": ["states.gate-1.gate", "states.gate-2.gate"]
}
