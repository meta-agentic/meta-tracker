{
  "template": "base",
  "version": 1,
  "name": "Base",
  "description": "Built-in root: the categories, outcomes and end states every workflow shares.",
  "states": {
    "todo": {"name": "To Do", "category": "START_STATE"},
    "in-progress": {"name": "In Progress", "category": "IN_PROGRESS"},
    "done": {"name": "Done", "category": "END_STATE", "outcome": "DELIVERED"},
    "no-go": {
      "name": "No Go",
      "category": "END_STATE",
      "outcome": "DISCONTINUED",
      "onBoard": false
    }
  },
  "stateOrder": ["todo", "in-progress", "done", "no-go"],
  "itemTypes": {
    "task": {"name": "Task"}
  },
  "fields": {},
  "settings": {"defaultItemType": "task"},
  "cadence": {"mode": "flow"}
}
